# ===== ECOUNT Open API 인증 정보 =====
# ERP 로그인 → Self-Customizing → 정보관리 → API 인증키 발급 메뉴에서 발급
# 셋 다 비워두면 자동으로 데모(샘플 데이터) 모드로 실행됩니다.
ECOUNT_COM_CODE=
ECOUNT_USER_ID=
ECOUNT_API_CERT_KEY=

# Zone(접속 서버 구분값)을 알고 있으면 지정, 비우면 자동 조회
ECOUNT_ZONE=

# 테스트 인증키 사용 시 true (sboapi 테스트 서버로 접속)
ECOUNT_TEST_SERVER=false

# 데모 모드 강제 (true/false, 비우면 인증키 유무로 자동 판단)
DEMO_MODE=

# ===== 분석 파라미터 =====
# 분석 대상 기간(개월)
ANALYSIS_MONTHS=12
# 일평균 출고·안전재고 계산에 쓰는 최근 기간(일)
RECENT_WINDOW_DAYS=90
# 발주 리드타임(일) — 발주 후 입고까지 걸리는 평균 일수
LEAD_TIME_DAYS=7
# 서비스 수준(품절 방지 목표 확률): 0.90 / 0.95 / 0.99
SERVICE_LEVEL=0.95
# 체화 판정 기준(무출고 경과일)
STAGNANT_CAUTION_DAYS=60
STAGNANT_DAYS=90
DEAD_DAYS=180
# ABC 등급 컷(매출 누적 점유율)
ABC_A_CUT=0.80
ABC_B_CUT=0.95
